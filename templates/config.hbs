<div class="pcs-config">
  <section>
    <h3>{{localize "PCSTATS.SelectCharacters"}}</h3>
    <p class="notes">{{localize "PCSTATS.SelectCharactersHint"}}</p>
    <div class="pcs-actor-list">
      {{#each actors}}
        <label class="pcs-actor-row">
          <input type="checkbox" name="actor.{{this.id}}" {{checked this.selected}}>
          <img src="{{this.img}}" alt="" width="28" height="28">
          <span>{{this.name}}</span>
        </label>
      {{else}}
        <p class="notes">{{localize "PCSTATS.NoCharacterActors"}}</p>
      {{/each}}
    </div>
  </section>

  <section>
    <h3>{{localize "PCSTATS.Fields"}}</h3>
    <p class="notes">{{localize "PCSTATS.FieldsHint"}}</p>
    <table class="pcs-fields">
      <thead>
        <tr>
          <th class="pcs-handle-col"></th>
          <th>{{localize "PCSTATS.Field"}}</th>
          <th>{{localize "PCSTATS.Enabled"}}</th>
          <th>{{localize "PCSTATS.FontSize"}}</th>
          <th>{{localize "PCSTATS.CustomColor"}}</th>
        </tr>
      </thead>
      <tbody class="pcs-field-rows">
        {{#each fields}}
          <tr class="pcs-field-row" draggable="true" data-key="{{this.key}}">
            <td class="pcs-drag-handle" title="{{localize "PCSTATS.DragToReorder"}}">
              <i class="fa-solid fa-grip-vertical"></i>
              <input type="hidden" name="field.{{this.key}}.order" value="{{this.order}}" class="pcs-order-input">
            </td>
            <td>{{localize this.label}}</td>
            <td><input type="checkbox" name="field.{{this.key}}.enabled" {{checked this.enabled}}></td>
            <td><input type="number" name="field.{{this.key}}.fontSize" value="{{this.fontSize}}" min="6" max="120" step="1"></td>
            <td class="pcs-color-cell">
              {{#unless this.isPortrait}}
                <input type="checkbox" name="field.{{this.key}}.colorEnabled" {{checked this.colorEnabled}} title="{{localize "PCSTATS.CustomColorHint"}}">
                <input type="color" name="field.{{this.key}}.color" value="{{this.colorValue}}">
              {{/unless}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <section class="pcs-appearance">
    <h3>{{localize "PCSTATS.Appearance"}}</h3>
    <div class="form-group">
      <label>{{localize "PCSTATS.TextColor"}}</label>
      <input type="color" name="textColor" value="{{textColor}}">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.ShowHpBar"}}</label>
      <input type="checkbox" name="showHpBar" {{checked showHpBar}}>
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.CardEnabled"}}</label>
      <input type="checkbox" name="cardEnabled" {{checked cardEnabled}}>
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.CardColor"}}</label>
      <input type="color" name="cardColor" value="{{cardColor}}">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.CardOpacity"}}</label>
      <input type="number" name="cardOpacity" value="{{cardOpacity}}" min="0" max="1" step="0.05">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.CardRadius"}}</label>
      <input type="number" name="cardRadius" value="{{cardRadius}}" min="0" max="80" step="1">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.PortraitSize"}}</label>
      <input type="number" name="portraitSize" value="{{portraitSize}}" min="20" max="400" step="2">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.PortraitShape"}}</label>
      <select name="portraitShape">
        {{#each portraitShapes}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.FieldGap"}}</label>
      <input type="number" name="fieldGap" value="{{fieldGap}}" min="0" max="120" step="1">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.PaddingX"}}</label>
      <input type="number" name="paddingX" value="{{paddingX}}" min="0" max="200" step="1">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.PaddingY"}}</label>
      <input type="number" name="paddingY" value="{{paddingY}}" min="0" max="200" step="1">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.ShowDividers"}}</label>
      <input type="checkbox" name="showDividers" {{checked showDividers}}>
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.DividerColor"}}</label>
      <input type="color" name="dividerColor" value="{{dividerColor}}">
    </div>
  </section>

  <section class="pcs-general">
    <h3>{{localize "PCSTATS.General"}}</h3>
    <div class="form-group">
      <label>{{localize "PCSTATS.RotateInterval"}}</label>
      <input type="number" name="rotateInterval" value="{{rotateInterval}}" min="0" step="0.5">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.BgColor"}}</label>
      <input type="color" name="bgColor" value="{{bgColor}}">
    </div>
    <div class="form-group">
      <label>{{localize "PCSTATS.BannerHeight"}}</label>
      <input type="number" name="bannerHeight" value="{{bannerHeight}}" min="50" max="1080" step="10">
    </div>
  </section>
</div>
