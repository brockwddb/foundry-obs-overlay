<div class="pcs-config">
  <nav class="pcs-tabs">
    {{#each panes}}
      <a class="pcs-tab {{#if @first}}active{{/if}}" data-tab="{{this.key}}">{{localize this.label}}</a>
    {{/each}}
    <a class="pcs-tab" data-tab="characters">{{localize "PCSTATS.TabCharacters"}}</a>
  </nav>

  {{#each panes}}
    <div class="pcs-pane {{#if @first}}active{{/if}}" data-pane="{{this.key}}">

      <section class="pcs-preview">
        <div class="pcs-preview-head">
          <span class="pcs-preview-title">{{localize "PCSTATS.Preview"}}</span>
          <div class="pcs-preview-actions">
            {{#if this.isBanner}}<button type="button" class="pcs-prev-btn" data-prev="message">{{localize "PCSTATS.PrevMessage"}}</button>{{/if}}
            <button type="button" class="pcs-prev-btn" data-prev="damage">{{localize "PCSTATS.PrevDamage"}}</button>
            <button type="button" class="pcs-prev-btn" data-prev="heal">{{localize "PCSTATS.PrevHeal"}}</button>
            <button type="button" class="pcs-prev-btn" data-prev="crit">{{localize "PCSTATS.PrevCrit"}}</button>
            <button type="button" class="pcs-prev-btn" data-prev="fumble">{{localize "PCSTATS.PrevFumble"}}</button>
          </div>
        </div>
        <iframe class="pcs-preview-frame" data-preview="{{this.key}}" title="preview"></iframe>
      </section>

      <p class="pcs-tab-intro">{{localize this.hint}}</p>

      <details class="pcs-group" open>
        <summary>{{localize "PCSTATS.GroupFields"}}</summary>
        <p class="field-help">{{localize "PCSTATS.FieldsHint"}}</p>
        <table class="pcs-fields">
          <thead>
            <tr>
              <th class="pcs-handle-col"></th>
              <th>{{localize "PCSTATS.Field"}}</th>
              <th>{{localize "PCSTATS.Enabled"}}</th>
              <th>{{localize "PCSTATS.FontSize"}}</th>
              <th>{{localize "PCSTATS.CustomColor"}}</th>
            </tr>
          </thead>
          <tbody class="pcs-field-rows">
            {{#each this.fields}}
              <tr class="pcs-field-row" draggable="true" data-key="{{this.key}}">
                <td class="pcs-drag-handle" title="{{localize "PCSTATS.DragToReorder"}}">
                  <i class="fa-solid fa-grip-vertical"></i>
                  <input type="hidden" name="{{../key}}.field.{{this.key}}.order" value="{{this.order}}" class="pcs-order-input">
                </td>
                <td>{{localize this.label}}</td>
                <td><input type="checkbox" name="{{../key}}.field.{{this.key}}.enabled" {{checked this.enabled}}></td>
                <td><input type="number" name="{{../key}}.field.{{this.key}}.fontSize" value="{{this.fontSize}}" min="6" max="120" step="1"></td>
                <td class="pcs-color-cell">
                  {{#unless this.isPortrait}}
                    <input type="checkbox" name="{{../key}}.field.{{this.key}}.colorEnabled" {{checked this.colorEnabled}} title="{{localize "PCSTATS.CustomColorHint"}}">
                    <input type="color" name="{{../key}}.field.{{this.key}}.color" value="{{this.colorValue}}">
                  {{/unless}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>

      <details class="pcs-group">
        <summary>{{localize "PCSTATS.GroupPlate"}}</summary>
        <p class="field-help">{{localize "PCSTATS.GroupPlateHelp"}}</p>
        <div class="form-group">
          <label>{{localize "PCSTATS.CardEnabled"}}</label>
          <input type="checkbox" name="{{this.key}}.cardEnabled" {{checked this.cfg.cardEnabled}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.CardColor"}}</label>
          <input type="color" name="{{this.key}}.cardColor" value="{{this.cfg.cardColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.CardOpacity"}}</label>
          <input type="number" name="{{this.key}}.cardOpacity" value="{{this.cfg.cardOpacity}}" min="0" max="1" step="0.05">
          <span class="field-help inline">{{localize "PCSTATS.HelpCardOpacity"}}</span>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.CardRadius"}}</label>
          <input type="number" name="{{this.key}}.cardRadius" value="{{this.cfg.cardRadius}}" min="0" max="80" step="1">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.TextureUrl"}}</label>
          <input type="text" class="pcs-texture-input" name="{{this.key}}.textureUrl" value="{{this.cfg.textureUrl}}" placeholder="{{localize "PCSTATS.ImagePlaceholder"}}">
          <button type="button" class="pcs-texture-browse" title="{{localize "PCSTATS.Browse"}}"><i class="fa-solid fa-image"></i></button>
        </div>
        <p class="field-help">{{localize "PCSTATS.HelpTexture"}}</p>
        <div class="form-group">
          <label>{{localize "PCSTATS.PlateShadow"}}</label>
          <input type="checkbox" name="{{this.key}}.plateShadow" {{checked this.cfg.plateShadow}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.BorderEnabled"}}</label>
          <input type="checkbox" name="{{this.key}}.borderEnabled" {{checked this.cfg.borderEnabled}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.BorderColor"}}</label>
          <input type="color" name="{{this.key}}.borderColor" value="{{this.cfg.borderColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.BorderWidth"}}</label>
          <input type="number" name="{{this.key}}.borderWidth" value="{{this.cfg.borderWidth}}" min="0" max="12" step="1">
        </div>
      </details>

      <details class="pcs-group">
        <summary>{{localize "PCSTATS.GroupText"}}</summary>
        <div class="form-group">
          <label>{{localize "PCSTATS.FontFamily"}}</label>
          <select name="{{this.key}}.fontFamily">
            {{#each this.fontFamilies}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.TextColor"}}</label>
          <input type="color" name="{{this.key}}.textColor" value="{{this.cfg.textColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.ShowDividers"}}</label>
          <input type="checkbox" name="{{this.key}}.showDividers" {{checked this.cfg.showDividers}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.DividerColor"}}</label>
          <input type="color" name="{{this.key}}.dividerColor" value="{{this.cfg.dividerColor}}">
        </div>
      </details>

      <details class="pcs-group">
        <summary>{{localize "PCSTATS.GroupHp"}}</summary>
        <div class="form-group">
          <label>{{localize "PCSTATS.ShowHpBar"}}</label>
          <input type="checkbox" name="{{this.key}}.showHpBar" {{checked this.cfg.showHpBar}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpBarHigh"}}</label>
          <input type="color" name="{{this.key}}.hpBarHigh" value="{{this.cfg.hpBarHigh}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpBarLow"}}</label>
          <input type="color" name="{{this.key}}.hpBarLow" value="{{this.cfg.hpBarLow}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpBarBg"}}</label>
          <input type="color" name="{{this.key}}.hpBarBg" value="{{this.cfg.hpBarBg}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpColorByHealth"}}</label>
          <input type="checkbox" name="{{this.key}}.hpColorByHealth" {{checked this.cfg.hpColorByHealth}}>
        </div>
        <p class="field-help">{{localize "PCSTATS.HelpHpByHealth"}}</p>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpHighColor"}}</label>
          <input type="color" name="{{this.key}}.hpHighColor" value="{{this.cfg.hpHighColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpMidColor"}}</label>
          <input type="color" name="{{this.key}}.hpMidColor" value="{{this.cfg.hpMidColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpLowColor"}}</label>
          <input type="color" name="{{this.key}}.hpLowColor" value="{{this.cfg.hpLowColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpMidThreshold"}}</label>
          <input type="number" name="{{this.key}}.hpMidThreshold" value="{{this.cfg.hpMidThreshold}}" min="0" max="100" step="1">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HpLowThreshold"}}</label>
          <input type="number" name="{{this.key}}.hpLowThreshold" value="{{this.cfg.hpLowThreshold}}" min="0" max="100" step="1">
        </div>
      </details>

      <details class="pcs-group">
        <summary>{{localize "PCSTATS.GroupLayout"}}</summary>
        <div class="form-group">
          <label>{{localize "PCSTATS.PortraitSize"}}</label>
          <input type="number" name="{{this.key}}.portraitSize" value="{{this.cfg.portraitSize}}" min="20" max="400" step="2">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.PortraitShape"}}</label>
          <select name="{{this.key}}.portraitShape">
            {{#each this.portraitShapes}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.FieldGap"}}</label>
          <input type="number" name="{{this.key}}.fieldGap" value="{{this.cfg.fieldGap}}" min="0" max="120" step="1">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.PaddingX"}}</label>
          <input type="number" name="{{this.key}}.paddingX" value="{{this.cfg.paddingX}}" min="0" max="200" step="1">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.PaddingY"}}</label>
          <input type="number" name="{{this.key}}.paddingY" value="{{this.cfg.paddingY}}" min="0" max="200" step="1">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.PlateEntrance"}}</label>
          <input type="checkbox" name="{{this.key}}.plateEntrance" {{checked this.cfg.plateEntrance}}>
          <span class="field-help inline">{{localize "PCSTATS.HelpPlateEntrance"}}</span>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.MaxWidth"}}</label>
          <input type="number" name="{{this.key}}.maxWidth" value="{{this.cfg.maxWidth}}" min="0" max="3840" step="10">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.MaxHeight"}}</label>
          <input type="number" name="{{this.key}}.maxHeight" value="{{this.cfg.maxHeight}}" min="0" max="2160" step="10">
        </div>
        <p class="field-help">{{localize "PCSTATS.HelpMaxSize"}}</p>
      </details>

      {{#if this.isBanner}}
        <details class="pcs-group">
          <summary>{{localize "PCSTATS.GroupRotation"}}</summary>
          <div class="form-group">
            <label>{{localize "PCSTATS.RotateInterval"}}</label>
            <input type="number" name="{{this.key}}.rotateInterval" value="{{this.cfg.rotateInterval}}" min="0" step="0.5">
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.CardGap"}}</label>
            <input type="number" name="{{this.key}}.cardGap" value="{{this.cfg.cardGap}}" min="0" max="600" step="1">
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.CardAnimation"}}</label>
            <select name="{{this.key}}.cardAnimation">
              {{#each this.cardAnimations}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.CardTransition"}}</label>
            <input type="number" name="{{this.key}}.cardTransition" value="{{this.cfg.cardTransition}}" min="0" max="5" step="0.05">
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.FeaturedIntro"}}</label>
            <input type="checkbox" name="{{this.key}}.featuredIntro" {{checked this.cfg.featuredIntro}}>
          </div>
          <p class="field-help">{{localize "PCSTATS.HelpFeaturedIntro"}}</p>
          <div class="form-group">
            <label>{{localize "PCSTATS.FeaturedText"}}</label>
            <input type="text" name="{{this.key}}.featuredText" value="{{this.cfg.featuredText}}" placeholder="Featured Character">
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.IntroDuration"}}</label>
            <input type="number" name="{{this.key}}.introDuration" value="{{this.cfg.introDuration}}" min="0.3" max="10" step="0.1">
          </div>
        </details>

        <details class="pcs-group">
          <summary>{{localize "PCSTATS.GroupMessages"}}</summary>
          <p class="field-help">{{localize "PCSTATS.MessagesHint"}}</p>
          <div class="pcs-msg-head">
            <span class="pcs-msg-h-enable" title="{{localize "PCSTATS.Enabled"}}"></span>
            <span class="pcs-msg-h-text">{{localize "PCSTATS.MessageText"}}</span>
            <span class="pcs-msg-h-image">{{localize "PCSTATS.MessageImage"}}</span>
            <span class="pcs-msg-h-weight" title="{{localize "PCSTATS.MessageWeight"}}">{{localize "PCSTATS.MessageWeightShort"}}</span>
            <span class="pcs-msg-h-del"></span>
          </div>
          <div class="pcs-msg-rows">
            {{#each this.messages}}
              <div class="pcs-msg-row">
                <input type="checkbox" name="{{../key}}.message.{{this.index}}.enabled" {{checked this.enabled}}>
                <input type="text" class="pcs-msg-text" name="{{../key}}.message.{{this.index}}.text" value="{{this.text}}" placeholder="{{localize "PCSTATS.MessagePlaceholder"}}">
                <input type="text" class="pcs-msg-image" name="{{../key}}.message.{{this.index}}.image" value="{{this.image}}" placeholder="{{localize "PCSTATS.ImagePlaceholder"}}">
                <button type="button" class="pcs-msg-browse" title="{{localize "PCSTATS.Browse"}}"><i class="fa-solid fa-image"></i></button>
                <input type="number" class="pcs-msg-weight" name="{{../key}}.message.{{this.index}}.weight" value="{{this.weight}}" min="1" max="10" step="1" title="{{localize "PCSTATS.MessageWeight"}}">
                <button type="button" class="pcs-msg-remove" title="{{localize "PCSTATS.RemoveMessage"}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            {{/each}}
          </div>
          <button type="button" class="pcs-msg-add"><i class="fa-solid fa-plus"></i> {{localize "PCSTATS.AddMessage"}}</button>
          <div class="form-group">
            <label>{{localize "PCSTATS.MessageFrequency"}}</label>
            <input type="number" name="{{this.key}}.messageFrequency" value="{{this.cfg.messageFrequency}}" min="0" max="20" step="1">
            <span class="field-help inline">{{localize "PCSTATS.HelpMessageFreq"}}</span>
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.MessageFontSize"}}</label>
            <input type="number" name="{{this.key}}.messageFontSize" value="{{this.cfg.messageFontSize}}" min="6" max="120" step="1">
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.MessageColor"}}</label>
            <input type="color" name="{{this.key}}.messageColor" value="{{this.cfg.messageColor}}">
          </div>
          <div class="form-group">
            <label>{{localize "PCSTATS.MessageImageHeight"}}</label>
            <input type="number" name="{{this.key}}.messageImageHeight" value="{{this.cfg.messageImageHeight}}" min="10" max="600" step="5">
          </div>
        </details>
      {{/if}}

      <details class="pcs-group">
        <summary>{{localize "PCSTATS.GroupCombat"}}</summary>
        <p class="field-help">{{localize "PCSTATS.CombatHint"}}</p>
        <div class="form-group">
          <label>{{localize "PCSTATS.CombatAnimations"}}</label>
          <input type="checkbox" name="{{this.key}}.combatAnimations" {{checked this.cfg.combatAnimations}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.CombatOnly"}}</label>
          <input type="checkbox" name="{{this.key}}.animationsCombatOnly" {{checked this.cfg.animationsCombatOnly}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.CombatAnimDuration"}}</label>
          <input type="number" name="{{this.key}}.combatAnimDuration" value="{{this.cfg.combatAnimDuration}}" min="1" max="15" step="0.5">
          <span class="field-help inline">{{localize "PCSTATS.HelpCombatDuration"}}</span>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.DamageColor"}}</label>
          <input type="color" name="{{this.key}}.damageColor" value="{{this.cfg.damageColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HealColor"}}</label>
          <input type="color" name="{{this.key}}.healColor" value="{{this.cfg.healColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.DiceFlair"}}</label>
          <input type="checkbox" name="{{this.key}}.diceFlair" {{checked this.cfg.diceFlair}}>
        </div>
        <p class="field-help">{{localize "PCSTATS.HelpDiceFlair"}}</p>
        <div class="form-group">
          <label>{{localize "PCSTATS.CritColor"}}</label>
          <input type="color" name="{{this.key}}.critColor" value="{{this.cfg.critColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.FumbleColor"}}</label>
          <input type="color" name="{{this.key}}.fumbleColor" value="{{this.cfg.fumbleColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.ShowDownState"}}</label>
          <input type="checkbox" name="{{this.key}}.showDownState" {{checked this.cfg.showDownState}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.HighlightActiveTurn"}}</label>
          <input type="checkbox" name="{{this.key}}.highlightActiveTurn" {{checked this.cfg.highlightActiveTurn}}>
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.TurnColor"}}</label>
          <input type="color" name="{{this.key}}.turnColor" value="{{this.cfg.turnColor}}">
        </div>
        {{#if this.isBanner}}
          <div class="form-group">
            <label>{{localize "PCSTATS.SpotlightCurrentTurn"}}</label>
            <input type="checkbox" name="{{this.key}}.spotlightCurrentTurn" {{checked this.cfg.spotlightCurrentTurn}}>
            <span class="field-help inline">{{localize "PCSTATS.HelpSpotlight"}}</span>
          </div>
        {{/if}}
      </details>

      <details class="pcs-group">
        <summary>{{localize "PCSTATS.GroupWindow"}}</summary>
        <p class="field-help">{{localize "PCSTATS.GroupWindowHelp"}}</p>
        <div class="form-group">
          <label>{{localize "PCSTATS.BgColor"}}</label>
          <input type="color" name="{{this.key}}.bgColor" value="{{this.cfg.bgColor}}">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.BannerWidth"}}</label>
          <input type="number" name="{{this.key}}.bannerWidth" value="{{this.cfg.bannerWidth}}" min="200" max="3840" step="10">
        </div>
        <div class="form-group">
          <label>{{localize "PCSTATS.BannerHeight"}}</label>
          <input type="number" name="{{this.key}}.bannerHeight" value="{{this.cfg.bannerHeight}}" min="50" max="1080" step="10">
        </div>
      </details>

      <div class="pcs-pane-actions">
        <button type="button" class="pcs-test" data-test="{{this.key}}">
          <i class="fa-solid fa-flask"></i> {{localize "PCSTATS.TestOverlay"}}
        </button>
        <button type="button" class="pcs-reset" data-reset="{{this.key}}">
          <i class="fa-solid fa-rotate-left"></i> {{localize "PCSTATS.ResetDefaults"}}
        </button>
      </div>
    </div>
  {{/each}}

  <div class="pcs-pane" data-pane="characters">
    <p class="pcs-tab-intro">{{localize "PCSTATS.CharactersHint"}}</p>

    <details class="pcs-group" open>
      <summary>{{localize "PCSTATS.GroupCharacters"}}</summary>
      <p class="field-help">{{localize "PCSTATS.SelectCharactersHint"}}</p>
      <div class="pcs-actor-list">
        {{#each characters}}
          <label class="pcs-actor-row">
            <input type="checkbox" name="actor.{{this.id}}" {{checked this.selected}}>
            <img src="{{this.img}}" alt="" width="28" height="28">
            <span>{{this.name}}</span>
          </label>
        {{else}}
          <p class="field-help">{{localize "PCSTATS.NoCharacterActors"}}</p>
        {{/each}}
      </div>
    </details>

    <details class="pcs-group">
      <summary>{{localize "PCSTATS.GroupCharacterStyles"}}</summary>
      <p class="field-help">{{localize "PCSTATS.StylingHint"}}</p>
      <div class="pcs-char-list">
        {{#each characters}}
          <div class="pcs-char-row" data-style-id="{{this.id}}">
            <img src="{{this.img}}" alt="" width="32" height="32">
            <span class="pcs-char-name">{{this.name}}</span>
            <label class="pcs-char-opt">
              <input type="checkbox" name="characters.{{this.id}}.accentOn" {{checked this.accentOn}}>
              {{localize "PCSTATS.Accent"}}
              <input type="color" name="characters.{{this.id}}.accent" value="{{this.accent}}">
            </label>
            <label class="pcs-char-opt">
              <input type="checkbox" name="characters.{{this.id}}.useToken" {{checked this.portraitToken}}>
              {{localize "PCSTATS.UseTokenArt"}}
            </label>
          </div>
        {{else}}
          <p class="field-help">{{localize "PCSTATS.NoCharacterActors"}}</p>
        {{/each}}
      </div>
    </details>

    <details class="pcs-group">
      <summary>{{localize "PCSTATS.Tools"}}</summary>
      <p class="field-help">{{localize "PCSTATS.CopyHint"}}</p>
      <div class="form-group">
        <label class="pcs-inline-label">{{localize "PCSTATS.CopyFrom"}}</label>
        <select class="pcs-copy-source">
          {{#each panes}}<option value="{{this.key}}">{{localize this.label}}</option>{{/each}}
        </select>
        <label class="pcs-inline-label">{{localize "PCSTATS.CopyTo"}}</label>
        <select class="pcs-copy-target">
          {{#each panes}}<option value="{{this.key}}">{{localize this.label}}</option>{{/each}}
        </select>
        <button type="button" class="pcs-copy-apply">{{localize "PCSTATS.CopyApply"}}</button>
      </div>
      <p class="field-help">{{localize "PCSTATS.ExportHint"}}</p>
      <div class="form-group">
        <button type="button" class="pcs-export"><i class="fa-solid fa-file-export"></i> {{localize "PCSTATS.Export"}}</button>
        <button type="button" class="pcs-import"><i class="fa-solid fa-file-import"></i> {{localize "PCSTATS.Import"}}</button>
        <input type="file" class="pcs-import-file" accept="application/json" style="display:none">
      </div>
    </details>
  </div>
</div>
